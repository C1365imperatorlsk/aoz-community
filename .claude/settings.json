{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit(//tmp/claude-0/**/scratchpad/AOZ_GLOBAL_AUDIT_REPORT.md)"
    ],
    "deny": [
      "Bash",
      "Edit(/**)",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "mcp__*",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)"
    ],
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable"
  }
}
